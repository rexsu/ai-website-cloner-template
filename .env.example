# Alipay open platform (optional). Without these, checkout uses 收款码 fallback.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://chanring.com/api/alipay/notify
ALIPAY_RETURN_URL=https://chanring.com/checkout?paid=1
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# Optional override for merchant QR image served by Next
ALIPAY_QR_IMAGE_PATH=/sites/qizai/payment/alipay-qr.png
